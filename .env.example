# App
HTTP_PORT=3000
SMTP_PORT=2525
HTTP_BIND_PORT=3000
SMTP_BIND_PORT=25
SMTP_HOST=0.0.0.0
HTTP_HOST=0.0.0.0
API_KEY=replace-with-your-api-key

# Comma-separated recipient allowlist. Entries can be domains or full email addresses.
# SMTP rejects RCPT TO values that do not match this list.
ALLOWED_RECIPIENTS=example.com,mail.example.com

# Data path inside this project for mounts, exports, and future attachments
DATA_DIR=./data

# Reuse an existing Postgres if you already have one
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mail_service

# Optional: join an existing Docker network, for example another service stack
EXTERNAL_DOCKER_NETWORK=

# Only used if you start compose.postgres.yml
POSTGRES_DB=mail_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
